# ============================================================
# Discord Bot 設定樣板
# 複製此檔為 .env 後填入實際值。.env 已在 .gitignore,不會被提交。
# ============================================================

# ─── Discord Bot ───────────────────────────────────────────
BOT_TOKEN=
CONTROL_THREAD_ID=
# 多個 guild 用逗號分隔,用於即時同步 slash commands
GUILD_IDS=

# ─── Minecraft 伺服器(舊單一伺服器設定,新增伺服器請用 /server_add) ───
MINECRAFT_JAR_KEYWORD=
MINECRAFT_START_BAT=
MINECRAFT_BASE_PATH=
MINECRAFT_RCON_PORT=25575
MINECRAFT_RCON_PASSWORD=
MINECRAFT_STATUS_THREAD_ID=

# ─── 7 Days to Die 伺服器 ───
SEVENDAY_DIR=
SEVENDAY_EXE=
SEVENDAY_KEYWORD=
SEVENDAY_TELNET_PORT=
SEVENDAY_TELNET_PASSWORD=
SEVENDAY_STATUS_THREAD_ID=
SEVENDAY_SAVE_PATH=

# ─── Night of the Dead 伺服器 ───
# NOTD_DIR：伺服器資料夾絕對路徑（啟動 .bat 所在處,也是執行時的工作目錄）
# NOTD_BAT：啟動用的 .bat 檔名
# NOTD_KEYWORD：進程偵測關鍵字（LFServer.exe），預設 LFServer
# NOTD_ALLOWED_USER_ID：可無視開放時段（22:00–05:00）、隨時啟動的使用者 Discord ID
NOTD_DIR=
NOTD_BAT=
NOTD_KEYWORD=LFServer
NOTD_ALLOWED_USER_ID=508966382331887626

# ─── 訊息轉發 ───
FORWARDER_CONFIG=data/forwarder_map.json

# ─── Brown Dust 2 新聞 ───
BDNEWS_DATA_FILE=data/news_data.json
BDNEWS_THREAD_ID=
BDUST_REMINDER_CHANNEL_ID=

# ─── 動畫歌曲(暫未啟用) ───
ANIME_SONG_DATA_FILE=data/anime_songs.json

# ─── 自動備份 ───
BACKUP_ROOT=

# ─── X / Twitter 追蹤 ───
TWITTER_USERNAME=
TWITTER_EMAIL=
TWITTER_PASSWORD=

# ─── FF14 新聞 ───
FF14_NEWS_THREAD_ID=
FF14_DATA_FILE=data/ff14news.json

# ─── 鳴潮 (Wuthering Waves) 公告推送 ───
# 推送頻道由 !wuwachannels add/remove 管理(data/wuwanews_channels.json),不在此設定
WUWA_DATA_FILE=data/wuwanews.json

# ─── 每日新聞推送 (Claude 排程任務寫入 data/daily_news.json) ───
DAILY_NEWS_TECH_CHANNEL_ID=
DAILY_NEWS_AI_CHANNEL_ID=
DAILY_NEWS_GITHUB_CHANNEL_ID=
DAILY_NEWS_STOCK_CHANNEL_ID=
