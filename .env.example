# ============================================================
# Discord Bot 設定樣板
# 複製此檔為 .env 後填入實際值。.env 已在 .gitignore,不會被提交。
# ============================================================

# ─── Discord Bot ───────────────────────────────────────────
BOT_TOKEN=
CONTROL_THREAD_ID=
# 多個 guild 用逗號分隔,用於即時同步 slash commands
GUILD_IDS=

# ─── Minecraft 伺服器(舊單一伺服器設定,新增伺服器請用 /server_add) ───
MINECRAFT_JAR_KEYWORD=
MINECRAFT_START_BAT=
MINECRAFT_BASE_PATH=
MINECRAFT_RCON_PORT=25575
MINECRAFT_RCON_PASSWORD=
MINECRAFT_STATUS_THREAD_ID=

# ─── 7 Days to Die 伺服器 ───
SEVENDAY_DIR=
SEVENDAY_EXE=
SEVENDAY_KEYWORD=
# SEVENDAY_CMDLINE_KEYWORD:選填。用客戶端 7DaysToDie.exe 當專用伺服器時,遊戲客戶端與伺服器同名,
# 設成 -dedicated 只把命令列含此字串的程序當伺服器;用 7DaysToDieServer.exe 時留空即可
SEVENDAY_CMDLINE_KEYWORD=
# SEVENDAY_START_TASK:選填。bot 以服務執行時,設成排程任務名稱(以使用者互動身分執行該啟動 .bat),
# 伺服器 console 才會顯示在桌面且重啟 bot 不會連帶砍伺服器;留空則由 bot 直接啟動(視窗不可見)
SEVENDAY_START_TASK=
SEVENDAY_TELNET_PORT=
SEVENDAY_TELNET_PASSWORD=
SEVENDAY_STATUS_THREAD_ID=
SEVENDAY_SAVE_PATH=

# ─── Night of the Dead 伺服器 ───
# NOTD_DIR：伺服器資料夾絕對路徑（啟動 .bat 所在處,也是執行時的工作目錄）
# NOTD_BAT：啟動用的 .bat 檔名
# NOTD_KEYWORD：進程偵測關鍵字（LFServer.exe），預設 LFServer
# NOTD_ALLOWED_USER_ID：可無視開放時段（22:00–05:00）、隨時啟動的使用者 Discord ID
NOTD_DIR=
NOTD_BAT=
NOTD_KEYWORD=LFServer
NOTD_ALLOWED_USER_ID=508966382331887626

# ─── 訊息轉發 ───
FORWARDER_CONFIG=data/forwarder_map.json

# ─── Brown Dust 2 新聞 ───
BDNEWS_DATA_FILE=data/news_data.json
BDNEWS_THREAD_ID=
BDUST_REMINDER_CHANNEL_ID=

# ─── 自動備份 ───
BACKUP_ROOT=

# ─── X / Twitter 追蹤 ───
TWITTER_USERNAME=
TWITTER_EMAIL=
TWITTER_PASSWORD=

# ─── FF14 新聞 ───
FF14_NEWS_THREAD_ID=
FF14_DATA_FILE=data/ff14news.json

# ─── 鳴潮 (Wuthering Waves) 公告推送 ───
# 推送頻道由 !wuwachannels add/remove 管理(data/wuwanews_channels.json),不在此設定
WUWA_DATA_FILE=data/wuwanews.json

# ─── 每日新聞推送 (Claude 排程任務寫入 data/daily_news.json) ───
DAILY_NEWS_TECH_CHANNEL_ID=
DAILY_NEWS_AI_CHANNEL_ID=
DAILY_NEWS_GITHUB_CHANNEL_ID=
DAILY_NEWS_STOCK_CHANNEL_ID=

# ─── NLLB 翻譯 ───
# NLLB_MODEL_NAME：HuggingFace 模型名,預設 facebook/nllb-200-distilled-1.3B
# NLLB_DEVICE：auto(自動偵測 GPU)/ cuda / cpu
# TRANSLATE_DEFAULT_TARGET：預設目標語言 FLORES-200 碼(繁中=zho_Hant)
# TRANSLATE_CHANNELS_FILE：自動翻譯頻道設定檔(由管理指令維護)
NLLB_MODEL_NAME=facebook/nllb-200-distilled-1.3B
NLLB_DEVICE=auto
TRANSLATE_DEFAULT_TARGET=zho_Hant
TRANSLATE_CHANNELS_FILE=data/translate_channels.json

# ─── 專案版本更新公告 (/release 指令) ───
# 專案、推送頻道、通知身分組全部由 /release 系列指令管理,寫進 RELEASE_NOTIFY_FILE,不在此設定
# GITHUB_TOKEN：選填。private repo 必填(需 repo 讀取權限);public repo 設了可把
#               GitHub API 額度從 60 次/小時提高到 5000 次/小時
# RELEASE_CHECK_INTERVAL_MINUTES：自動檢查間隔,也可用 /release interval 即時調整
RELEASE_NOTIFY_FILE=data/release_notify.json
GITHUB_TOKEN=
RELEASE_CHECK_INTERVAL_MINUTES=300

# ─── 表情回應領取身分組 (/rr 指令) ───
# 面板訊息與「表情符號 → 身分組」對照全部由 /rr 指令管理,按伺服器分層寫進
# REACTION_ROLES_FILE,不在此設定。檔案首次啟動會自動建立。
# 前置條件:Developer Portal 需開啟 Server Members Intent;bot 需要「管理身分組」權限,
#           且 bot 的身分組位階要高於所有要發放的身分組。
REACTION_ROLES_FILE=data/reaction_roles.json
